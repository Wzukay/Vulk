#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct GrassInstance {
    vec3 position;
    float rotation;
    vec3 scale;
    float windOffset;
};

struct VkDrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

// Bindings setup to match renderer_grass.cpp
layout(std430, set = 0, binding = 0) readonly buffer InInstances { GrassInstance inData[]; };
layout(std430, set = 0, binding = 1) writeonly buffer OutInstances { GrassInstance outData[]; };
layout(std430, set = 0, binding = 2) buffer DrawCmd { VkDrawIndirectCommand cmd; };

layout(push_constant) uniform GrassComputePushConstants {
    vec3 cameraPos;
    float fadeStart;
    uint totalInstances;
    uint vertexCount;
    float fadeEnd;
    float _padding;
    vec4 frustumPlanes[6];
} push;

// Fast pseudo-random hash based on instance ID
float hash(uint n) {
    n = (n << 13U) ^ n;
    n = n * (n * n * 15731U + 789221U) + 1376312589U;
    return float(n & 0x7fffffffU) / float(0x7fffffff);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= push.totalInstances) return;

    GrassInstance inst = inData[idx];
    vec3 pos = inst.position;

    // 1. GPU Frustum Culling
    bool visible = true;
    for (int i = 0; i < 6; i++) {
        if (dot(push.frustumPlanes[i].xyz, pos) + push.frustumPlanes[i].w + 10.0 < 0.0) {
            visible = false;
            break;
        }
    }
    if (!visible) return;

    // 2. Maximum Distance Cutoff (tied directly to UI settings)
    float dist = length(pos - push.cameraPos);
    if (dist > push.fadeEnd) return;

    // 3. Distance-Based Density Thinning
    // Start thinning out at 40% of the UI fadeStart distance (e.g. 240 units if fadeStart is 600)
    float thinStart = push.fadeStart * 0.4; 

    if (dist > thinStart) {
        float t = clamp((dist - thinStart) / (push.fadeEnd - thinStart), 0.0, 1.0);

        float horizonFade = smoothstep(0.85, 1.0, t);
        float survivalProbability = mix(1.0, 0.0, t); 
        
        survivalProbability *= (1.0 - horizonFade);

        if (hash(idx) > survivalProbability) {
            return;
        }
    }

    // 4. Passed all tests! Add to the draw buffer.
    uint outIdx = atomicAdd(cmd.instanceCount, 1);
    outData[outIdx] = inst;

    if (outIdx == 0) {
        cmd.vertexCount = push.vertexCount;
        cmd.firstVertex = 0;
        cmd.firstInstance = 0;
    }
}