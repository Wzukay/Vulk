#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct WaterChunk {
    vec4 centerRadius;
    uint indexCount;
    uint firstIndex;
    int vertexOffset;
    uint padding;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer WaterChunks {
    WaterChunk chunks[];
};

layout(std430, set = 0, binding = 1) writeonly buffer DrawCommands {
    DrawCommand commands[];
};

layout(std430, set = 0, binding = 2) buffer DrawCount {
    uint visibleCount;
};

layout(push_constant) uniform CullPushConstants {
    mat4 viewProj;
    vec3 cameraPos;
    float maxDistance;
    uint chunkCount;
} push;

bool IsChunkVisible(WaterChunk chunk) {
    vec3 center = chunk.centerRadius.xyz;
    float radius = chunk.centerRadius.w;

    // 1. Distance Cull (If it's hidden deep in the fog, don't draw it)
    if (length(center - push.cameraPos) > push.maxDistance + radius) {
        return false;
    }

    // 2. Transpose the matrix so we can extract the ROWS instead of COLUMNS!
    mat4 m = transpose(push.viewProj);
    vec4 planes[6];
    
    // Extract true 3D Frustum Planes
    planes[0] = m[3] + m[0]; // Left
    planes[1] = m[3] - m[0]; // Right
    planes[2] = m[3] + m[1]; // Bottom
    planes[3] = m[3] - m[1]; // Top
    planes[4] = m[2];        // Near
    planes[5] = m[3] - m[2]; // Far

    // 3. Test the chunk's bounding sphere against all 6 planes
    for (int i = 0; i < 6; i++) {
        float l = length(planes[i].xyz); // Normalize the plane normal
        
        // If the sphere is completely on the negative side of the plane, it is outside the camera!
        if (dot(planes[i].xyz / l, center) + (planes[i].w / l) + radius < 0.0) {
            return false;
        }
    }

    return true;
}

void main() {
    uint chunkIndex = gl_GlobalInvocationID.x;

    if (chunkIndex >= push.chunkCount) {
        return;
    }

    WaterChunk chunk = chunks[chunkIndex];

    if (!IsChunkVisible(chunk)) {
        return;
    }

    uint drawIndex = atomicAdd(visibleCount, 1);

    commands[drawIndex].indexCount = chunk.indexCount;
    commands[drawIndex].instanceCount = 1;
    commands[drawIndex].firstIndex = chunk.firstIndex;
    commands[drawIndex].vertexOffset = chunk.vertexOffset;
    commands[drawIndex].firstInstance = 0;
}