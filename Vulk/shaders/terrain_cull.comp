#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct TerrainChunkData {
    vec4 centerRadius; 
    uint indexCount;
    uint firstIndex;
    uint vertexOffset;
    uint lod;
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer TerrainChunks { TerrainChunkData chunks[]; };
layout(std430, set = 0, binding = 1) writeonly buffer DrawCommands { VkDrawIndexedIndirectCommand commands[]; };
layout(std430, set = 0, binding = 2) buffer DrawCount { uint visibleCount; };
layout(set = 0, binding = 3) uniform sampler2D hzb;

layout(push_constant, std430) uniform CullPushConstants {
    mat4 viewProj;          // 64 bytes (offset 0)
    vec4 fadeParams;        // 16 bytes (offset 64)
    vec3 cameraPos;         // 12 bytes (offset 80) — aligned to 4 because std430 doesn't pad vec3 to 16!
    float chunkSize;        // 4 bytes (offset 92)
    vec2 hzbSize;           // 8 bytes (offset 96)
    float maxMip;           // 4 bytes (offset 104)
    float transitionWidth;  // 4 bytes (offset 108)
    uint totalChunks;       // 4 bytes (offset 112)
    // Total: 116 bytes
} push;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= push.totalChunks) return;

    TerrainChunkData chunk = chunks[idx];
    vec3 center = chunk.centerRadius.xyz;
    float radius = chunk.centerRadius.w;

    vec3 minB = center - vec3(radius);
    vec3 maxB = center + vec3(radius);
    vec3 corners[8] = {
        vec3(minB.x, minB.y, minB.z), vec3(maxB.x, minB.y, minB.z),
        vec3(minB.x, maxB.y, minB.z), vec3(maxB.x, maxB.y, minB.z),
        vec3(minB.x, minB.y, maxB.z), vec3(maxB.x, minB.y, maxB.z),
        vec3(minB.x, maxB.y, maxB.z), vec3(maxB.x, maxB.y, maxB.z)
    };

    vec2 minXY = vec2(2.0);
    vec2 maxXY = vec2(-2.0);
    float minZ = 1.0;
    
    bool allLeft = true, allRight = true, allTop = true, allBottom = true, allNear = true, allFar = true;
    
    // --- FIX 1: Track if the chunk crosses behind the camera ---
    bool intersectsNearPlane = false;

    for(int i = 0; i < 8; i++) {
        vec4 clip = push.viewProj * vec4(corners[i], 1.0);

        // If any corner is behind the near plane, flag it
        if (clip.w <= 0.0) intersectsNearPlane = true;

        float expand = clip.w * 0.5;
        if(clip.x >= -clip.w - expand) allLeft = false;
        if(clip.x <=  clip.w + expand) allRight = false;
        if(clip.y >= -clip.w - expand) allTop = false;
        if(clip.y <=  clip.w + expand) allBottom = false;
        if(clip.z >= 0.0) allNear = false;
        if(clip.z <= clip.w) allFar = false;

        if(clip.w > 0.0) {
            clip.xyz /= clip.w;
            clip.xy = clip.xy * 0.5 + 0.5; // Convert to [0, 1] UV space
            minXY = min(minXY, clip.xy);
            maxXY = max(maxXY, clip.xy);
            minZ = min(minZ, clip.z);
        }
    }

    if(allLeft || allRight || allTop || allBottom || allNear || allFar) {
        return;
    }

    // --- FIX 2: Only check occlusion if we aren't standing inside the chunk ---
    // If we are standing inside it, it's mathematically impossible to be fully occluded.
    if (!intersectsNearPlane) {
        minXY = clamp(minXY, 0.0, 1.0);
        maxXY = clamp(maxXY, 0.0, 1.0);

        vec2 size = (maxXY - minXY) * push.hzbSize;
        float mip = clamp(floor(log2(max(size.x, size.y))), 0.0, push.maxMip);

        float d1 = textureLod(hzb, vec2(minXY.x, minXY.y), mip).r;
        float d2 = textureLod(hzb, vec2(maxXY.x, minXY.y), mip).r;
        float d3 = textureLod(hzb, vec2(minXY.x, maxXY.y), mip).r;
        float d4 = textureLod(hzb, vec2(maxXY.x, maxXY.y), mip).r;
        
        float maxDepth = max(max(d1, d2), max(d3, d4));

        // If the closest point of the chunk is further than the farthest occluder, it's hidden
        if (minZ > maxDepth) {
            return; 
        }
    }

    float dist = length(center - push.cameraPos);
    float closestEdge = max(0.0, dist - (push.chunkSize * 0.75));
    float transWidth = push.transitionWidth;
    float blend = 0.0;

    // Note: chunk.lod is the LOD the geometry was generated with.
    // We compute the blend from that LOD toward the next higher LOD.
    if (chunk.lod == 0) {
        float transStart = push.fadeParams.z - transWidth; // grassFadeStart - transWidth
        float transEnd   = push.fadeParams.z;              // grassFadeStart
        blend = clamp((closestEdge - transStart) / (transEnd - transStart), 0.0, 1.0);
    } else if (chunk.lod == 1) {
        float transStart = push.fadeParams.w - transWidth; // grassFadeEnd - transWidth
        float transEnd   = push.fadeParams.w;              // grassFadeEnd
        blend = clamp((closestEdge - transStart) / (transEnd - transStart), 0.0, 1.0);
    } else if (chunk.lod == 2) {
        float transStart = push.fadeParams.x - transWidth; // staticFadeStart - transWidth
        float transEnd   = push.fadeParams.x;              // staticFadeStart
        blend = clamp((closestEdge - transStart) / (transEnd - transStart), 0.0, 1.0);
    } else if (chunk.lod == 3) {
        float transStart = push.fadeParams.y - transWidth; // staticFadeEnd - transWidth
        float transEnd   = push.fadeParams.y;              // staticFadeEnd
        blend = clamp((closestEdge - transStart) / (transEnd - transStart), 0.0, 1.0);
    } else {
        // LOD 4 (culled or very far) – fully coarse
        blend = 1.0;
    }

    float protectedLod0Range = push.chunkSize * 1.75;

    if (chunk.lod == 0 && dist < protectedLod0Range) {
        blend = 0.0;
    }

    // Smoothstep for nicer transition
    blend = blend * blend * blend * (blend * (blend * 6.0 - 15.0) + 10.0);

    // --- Write indirect command ---
    uint drawIdx = atomicAdd(visibleCount, 1);
    commands[drawIdx].indexCount = chunk.indexCount;
    commands[drawIdx].instanceCount = 1;
    commands[drawIdx].firstIndex = chunk.firstIndex;
    commands[drawIdx].vertexOffset = int(chunk.vertexOffset);
    commands[drawIdx].firstInstance = floatBitsToUint(blend);
}